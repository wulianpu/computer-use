# Default to LF for our own files, but keep all generated material
# byte-exact — hash verification and projection regeneration compare the
# exact bytes the generators wrote, so git must never rewrite them.
* text=auto eol=lf

# Raw upstream source cache (sha256-pinned by upstream/cua.lock.json).
upstream/source/cua-driver/* -text linguist-generated=true

# Projected production skill (regenerated by scripts/project_cua_skill.py).
skills/cua-driver/* -text linguist-generated=true

# Upstream license copy.
licenses/CUA-LICENSE.md -text linguist-generated=true

# Generated machine-readable projection metadata.
upstream/projection.json linguist-generated=true
upstream/projection-report.json linguist-generated=true

# Generated contract snapshot (evidence, human-reviewed diffs only).
tests/contract/cua-tools.snapshot.json linguist-generated=true

*.png binary
*.jpg binary
*.py text
*.json text
*.md text
